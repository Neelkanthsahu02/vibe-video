# OpenRouter — used for vision + LLM
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_REASONING_MODEL=anthropic/claude-sonnet-4-6

# Brave Search — used in Phase 3 for image/clip discovery
BRAVE_SEARCH_API_KEY=

# Binaries (override if not on PATH)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
PYTHON_BIN=python3
YT_DLP_BIN=yt-dlp

# Local data roots
STYLE_LIBRARY_DIR=./style-library
ASSET_LIBRARY_DIR=./asset-library
PROJECTS_DIR=./projects

# Tuning
VISION_FRAMES_PER_BEAT=2
VISION_CONCURRENCY=3
SCENE_DETECT_THRESHOLD=27.0
