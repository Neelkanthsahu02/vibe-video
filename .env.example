# ── core gateways ────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_REASONING_MODEL=anthropic/claude-sonnet-4-6

APIFY_API_KEY=
APIFY_YT_CHANNEL_ACTOR=streamers/youtube-channel-scraper
APIFY_YT_SCRAPER_ACTOR=streamers/youtube-scraper

BRAVE_SEARCH_API_KEY=

# Optional
YOUTUBE_DATA_API_KEY=

# ── local binaries (override if not on PATH) ─────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
PYTHON_PATH=python3

# ── whisper ──────────────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANG=
WHISPER_MODEL_PATH=

# ── data roots ───────────────────────────────────────────────────
LOCAL_RENDER_PATH=./projects
STYLE_PRESETS_DIR=./style-presets
ASSET_LIBRARY_DIR=./asset-library
REFERENCE_VIDEOS_DIR=./reference-videos
CACHE_DIR=./cache

# ── tuning ───────────────────────────────────────────────────────
VISION_FRAMES_PER_BEAT=2
VISION_CONCURRENCY=3
SCENE_DETECT_THRESHOLD=27.0

# ── legacy (kept for old src/ pipeline) ──────────────────────────
STYLE_LIBRARY_DIR=./style-library
PROJECTS_DIR=./projects
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
PYTHON_BIN=python3
YT_DLP_BIN=yt-dlp
