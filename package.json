{
  "name": "vibe-video",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI Video Editor — Channel Style Library Builder",
  "type": "module",
  "main": "dist-desktop/main/desktop/main/main.js",
  "bin": {
    "vibe": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "vibe": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.remotion.json && tsc --noEmit -p desktop/renderer/tsconfig.json",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts VibeVideo",
    "desktop:dev": "concurrently -k -n vite,electron -c blue,magenta \"vite -c desktop/vite.config.ts\" \"wait-on tcp:5180 && npm run desktop:main:build && cross-env VIBE_DEV_URL=http://localhost:5180 electron dist-desktop/main/desktop/main/main.js\"",
    "desktop:main:build": "tsc -p desktop/main/tsconfig.json",
    "desktop:renderer:build": "vite build -c desktop/vite.config.ts",
    "desktop:build": "npm run desktop:main:build && npm run desktop:renderer:build",
    "desktop:start": "npm run desktop:build && electron dist-desktop/main/desktop/main/main.js",
    "analyze:channel": "tsx scripts/analyze-channel.ts",
    "analyze:video": "tsx scripts/analyze-video.ts",
    "preset:generate": "tsx scripts/preset-generate.ts"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.5.1",
    "fast-glob": "^3.3.2",
    "p-limit": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
